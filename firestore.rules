rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'aplicativoqueirozapp@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'ADMIN' &&
         getUserData().active == true)
      );
    }

    function isSystemActive() {
      return isAuthenticated() && (
        request.auth.token.email == 'aplicativoqueirozapp@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().active == true)
      );
    }

    // Helper function to verify that historical product fields inside an item map are unchanged
    function itemHistoricalMatch(oldItem, newItem) {
      return oldItem.productId == newItem.productId &&
             oldItem.barcode == newItem.barcode &&
             oldItem.productName == newItem.productName &&
             oldItem.unit == newItem.unit &&
             oldItem.requestedQuantity == newItem.requestedQuantity;
    }

    // Helper function to verify that list size and historical item fields are preserved across updates (up to 20 items)
    function itemsHistoricalPreserved(oldItems, newItems) {
      return oldItems is list && newItems is list &&
             oldItems.size() == newItems.size() &&
             (oldItems.size() < 1 || itemHistoricalMatch(oldItems[0], newItems[0])) &&
             (oldItems.size() < 2 || itemHistoricalMatch(oldItems[1], newItems[1])) &&
             (oldItems.size() < 3 || itemHistoricalMatch(oldItems[2], newItems[2])) &&
             (oldItems.size() < 4 || itemHistoricalMatch(oldItems[3], newItems[3])) &&
             (oldItems.size() < 5 || itemHistoricalMatch(oldItems[4], newItems[4])) &&
             (oldItems.size() < 6 || itemHistoricalMatch(oldItems[5], newItems[5])) &&
             (oldItems.size() < 7 || itemHistoricalMatch(oldItems[6], newItems[6])) &&
             (oldItems.size() < 8 || itemHistoricalMatch(oldItems[7], newItems[7])) &&
             (oldItems.size() < 9 || itemHistoricalMatch(oldItems[8], newItems[8])) &&
             (oldItems.size() < 10 || itemHistoricalMatch(oldItems[9], newItems[9])) &&
             (oldItems.size() < 11 || itemHistoricalMatch(oldItems[10], newItems[10])) &&
             (oldItems.size() < 12 || itemHistoricalMatch(oldItems[11], newItems[11])) &&
             (oldItems.size() < 13 || itemHistoricalMatch(oldItems[12], newItems[12])) &&
             (oldItems.size() < 14 || itemHistoricalMatch(oldItems[13], newItems[13])) &&
             (oldItems.size() < 15 || itemHistoricalMatch(oldItems[14], newItems[14])) &&
             (oldItems.size() < 16 || itemHistoricalMatch(oldItems[15], newItems[15])) &&
             (oldItems.size() < 17 || itemHistoricalMatch(oldItems[16], newItems[16])) &&
             (oldItems.size() < 18 || itemHistoricalMatch(oldItems[17], newItems[17])) &&
             (oldItems.size() < 19 || itemHistoricalMatch(oldItems[18], newItems[18])) &&
             (oldItems.size() < 20 || itemHistoricalMatch(oldItems[19], newItems[19]));
    }

    // Helper function to verify that productIds elements strictly correspond to items[i].productId on creation (up to 20 items)
    function productIdsMatchItems(items, productIds) {
      return items is list && productIds is list && items.size() == productIds.size() &&
        (items.size() < 1 || items[0].productId == productIds[0]) &&
        (items.size() < 2 || items[1].productId == productIds[1]) &&
        (items.size() < 3 || items[2].productId == productIds[2]) &&
        (items.size() < 4 || items[3].productId == productIds[3]) &&
        (items.size() < 5 || items[4].productId == productIds[4]) &&
        (items.size() < 6 || items[5].productId == productIds[5]) &&
        (items.size() < 7 || items[6].productId == productIds[6]) &&
        (items.size() < 8 || items[7].productId == productIds[7]) &&
        (items.size() < 9 || items[8].productId == productIds[8]) &&
        (items.size() < 10 || items[9].productId == productIds[9]) &&
        (items.size() < 11 || items[10].productId == productIds[10]) &&
        (items.size() < 12 || items[11].productId == productIds[11]) &&
        (items.size() < 13 || items[12].productId == productIds[12]) &&
        (items.size() < 14 || items[13].productId == productIds[13]) &&
        (items.size() < 15 || items[14].productId == productIds[14]) &&
        (items.size() < 16 || items[15].productId == productIds[15]) &&
        (items.size() < 17 || items[16].productId == productIds[16]) &&
        (items.size() < 18 || items[17].productId == productIds[17]) &&
        (items.size() < 19 || items[18].productId == productIds[18]) &&
        (items.size() < 20 || items[19].productId == productIds[19]);
    }

    // Helper function to verify that if itemProductId is provided, it exists in items list directly or via productIds (up to 20 items)
    function itemProductIdValidForRequest(requestId, itemProductId) {
      let reqData = get(/databases/$(database)/documents/withdrawalRequests/$(requestId)).data;
      return itemProductId == null || (
        (reqData.items is list && (
          (reqData.items.size() > 0 && reqData.items[0].productId == itemProductId) ||
          (reqData.items.size() > 1 && reqData.items[1].productId == itemProductId) ||
          (reqData.items.size() > 2 && reqData.items[2].productId == itemProductId) ||
          (reqData.items.size() > 3 && reqData.items[3].productId == itemProductId) ||
          (reqData.items.size() > 4 && reqData.items[4].productId == itemProductId) ||
          (reqData.items.size() > 5 && reqData.items[5].productId == itemProductId) ||
          (reqData.items.size() > 6 && reqData.items[6].productId == itemProductId) ||
          (reqData.items.size() > 7 && reqData.items[7].productId == itemProductId) ||
          (reqData.items.size() > 8 && reqData.items[8].productId == itemProductId) ||
          (reqData.items.size() > 9 && reqData.items[9].productId == itemProductId) ||
          (reqData.items.size() > 10 && reqData.items[10].productId == itemProductId) ||
          (reqData.items.size() > 11 && reqData.items[11].productId == itemProductId) ||
          (reqData.items.size() > 12 && reqData.items[12].productId == itemProductId) ||
          (reqData.items.size() > 13 && reqData.items[13].productId == itemProductId) ||
          (reqData.items.size() > 14 && reqData.items[14].productId == itemProductId) ||
          (reqData.items.size() > 15 && reqData.items[15].productId == itemProductId) ||
          (reqData.items.size() > 16 && reqData.items[16].productId == itemProductId) ||
          (reqData.items.size() > 17 && reqData.items[17].productId == itemProductId) ||
          (reqData.items.size() > 18 && reqData.items[18].productId == itemProductId) ||
          (reqData.items.size() > 19 && reqData.items[19].productId == itemProductId)
        )) ||
        (reqData.productIds is list && itemProductId in reqData.productIds)
      );
    }

    // Users collection rules
    match /users/{userId} {
      allow get, list: if isAuthenticated();

      // Creation rule: Admins can create operational users; Bootstrap primary admin is allowed for aplicativoqueirozapp@gmail.com
      allow create: if (
        isAdmin() || 
        (isAuthenticated() && request.auth.uid == userId && request.auth.token.email == 'aplicativoqueirozapp@gmail.com' && request.resource.data.role == 'ADMIN' && request.resource.data.active == true)
      ) && 
        request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role', 'storeId', 'active', 'createdAt', 'mustChangePassword']) &&
        request.resource.data.uid == userId &&
        request.resource.data.active is bool &&
        request.resource.data.mustChangePassword is bool &&
        request.resource.data.createdAt is number;

      // Users can update non-critical profile fields (e.g. name), but are strictly prohibited
      // from altering uid, role, storeId, sectorId, active, email, or createdAt.
      // Users can only change mustChangePassword from true to false, never false to true.
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isOwner(userId) && 
         isSystemActive() &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.storeId == resource.data.storeId &&
         request.resource.data.sectorId == resource.data.sectorId &&
         request.resource.data.active == resource.data.active &&
         request.resource.data.email == resource.data.email &&
         request.resource.data.createdAt == resource.data.createdAt &&
         (request.resource.data.mustChangePassword == resource.data.mustChangePassword ||
          (resource.data.mustChangePassword == true && request.resource.data.mustChangePassword == false)))
      );

      allow delete: if false;
    }

    // Products collection rules (Global Network Catalog)
    match /products/{productId} {
      allow read: if isSystemActive();

      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['id', 'barcode', 'name', 'unit', 'active', 'createdAt', 'updatedAt']) &&
        request.resource.data.id == productId &&
        request.resource.data.barcode is string &&
        request.resource.data.name is string &&
        request.resource.data.unit is string &&
        request.resource.data.active is bool;

      allow update: if isAdmin() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Stores collection rules (Etapa 11)
    match /stores/{storeId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Sectors collection rules (Etapa 11)
    match /sectors/{sectorId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Withdrawal Requests collection rules (Etapa 11)
    match /withdrawalRequests/{requestId} {
      // Read: Leaders can read ONLY their own requests, AVARISTA can read ONLY requests from their store, ADMIN can read all
      allow read: if isSystemActive() && (
        isAdmin() ||
        (getUserData().role == 'SETOR_LEADER' && resource.data.requestedBy == request.auth.uid) ||
        (getUserData().role == 'AVARISTA' && resource.data.storeId == getUserData().storeId)
      );

      // Create: Only SETOR_LEADER can create requests for their own store AND sector with status PENDING.
      // productIds elements must strictly match items[i].productId.
      allow create: if isSystemActive() &&
        getUserData().role == 'SETOR_LEADER' &&
        request.resource.data.keys().hasAll(['id', 'storeId', 'sectorId', 'requestedBy', 'requestedByName', 'createdAt', 'status', 'items', 'productIds']) &&
        request.resource.data.id == requestId &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.storeId == getUserData().storeId &&
        request.resource.data.sectorId == getUserData().sectorId &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        productIdsMatchItems(request.resource.data.items, request.resource.data.productIds);

      // Update: AVARISTA can update pending requests in their store to start/perform/finish conference.
      allow update: if isSystemActive() &&
        getUserData().role == 'AVARISTA' &&
        resource.data.storeId == getUserData().storeId &&
        request.resource.data.requestedBy == resource.data.requestedBy &&
        request.resource.data.requestedByName == resource.data.requestedByName &&
        request.resource.data.storeId == resource.data.storeId &&
        request.resource.data.sectorId == resource.data.sectorId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.productIds == resource.data.productIds &&
        itemsHistoricalPreserved(resource.data.items, request.resource.data.items) &&
        !(resource.data.status in ['COMPLETED', 'DIVERGENCE']) && (
          // Case 1: Start conference from PENDING to IN_CONFERENCE
          (resource.data.status == 'PENDING' && request.resource.data.status == 'IN_CONFERENCE' && request.resource.data.conferenceStartedBy == request.auth.uid) ||
          // Case 2: Perform/Finish conference when already IN_CONFERENCE by same AVARISTA
          (resource.data.status == 'IN_CONFERENCE' && resource.data.conferenceStartedBy == request.auth.uid && request.resource.data.status in ['IN_CONFERENCE', 'COMPLETED', 'DIVERGENCE'] && (
            (request.resource.data.status != 'DIVERGENCE') ||
            (request.resource.data.status == 'DIVERGENCE' && request.resource.data.divergenceReason is string && request.resource.data.divergenceReason.size() > 0)
          ))
        );

      // Delete: Disallow any user from deleting submitted requests to preserve audit trail
      allow delete: if false;

      // Evidence subcollection rules (Etapa 11)
      match /evidence/{evidenceId} {
        allow read: if isSystemActive() && (
          isAdmin() ||
          (getUserData().role == 'SETOR_LEADER' && get(/databases/$(database)/documents/withdrawalRequests/$(requestId)).data.requestedBy == request.auth.uid) ||
          (getUserData().role == 'AVARISTA' && get(/databases/$(database)/documents/withdrawalRequests/$(requestId)).data.storeId == getUserData().storeId)
        );

        allow create: if isSystemActive() &&
          getUserData().role == 'AVARISTA' &&
          exists(/databases/$(database)/documents/withdrawalRequests/$(requestId)) &&
          get(/databases/$(database)/documents/withdrawalRequests/$(requestId)).data.storeId == getUserData().storeId &&
          get(/databases/$(database)/documents/withdrawalRequests/$(requestId)).data.status == 'IN_CONFERENCE' &&
          get(/databases/$(database)/documents/withdrawalRequests/$(requestId)).data.conferenceStartedBy == request.auth.uid &&
          request.resource.data.id == evidenceId &&
          request.resource.data.requestId == requestId &&
          request.resource.data.storeId == getUserData().storeId &&
          request.resource.data.uploadedBy == request.auth.uid &&
          request.resource.data.createdAt is number &&
          itemProductIdValidForRequest(requestId, request.resource.data.itemProductId);

        allow update: if false;
        allow delete: if false;
      }
    }

    // AuditLogs collection rules (Immutable audit trail - Etapa 13.2 Hardened)
    match /auditLogs/{auditId} {
      allow get, list: if isAdmin();

      // Creation rule with strict action, role, and entity scope validation
      allow create: if isAuthenticated() && isSystemActive() &&
        request.resource.data.keys().hasAll(['id', 'action', 'entityType', 'entityId', 'userId', 'userRole', 'timestamp']) &&
        request.resource.data.id == auditId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userRole == getUserData().role &&
        (request.resource.data.timestamp == request.time || request.resource.data.timestamp is timestamp || request.resource.data.timestamp is number) &&
        // No sensitive keys allowed in metadata
        (!request.resource.data.keys().hasAny(['metadata']) || 
         !request.resource.data.metadata.keys().hasAny(['password', 'pass', 'token', 'refreshToken', 'apiKey', 'secret', 'credential', 'pin'])) &&
        // Action permission validation:
        (
          // 1. ADMIN: Can record administrative events with verified entity existence
          (
            isAdmin() && request.resource.data.userRole == 'ADMIN' &&
            (
              // Entity existence checks for updates and status changes
              (!(request.resource.data.action in ['USER_ACTIVATED', 'USER_DEACTIVATED', 'USER_STORE_CHANGED', 'USER_SECTOR_CHANGED']) || exists(/databases/$(database)/documents/users/$(request.resource.data.entityId))) &&
              (!(request.resource.data.action in ['STORE_ACTIVATED', 'STORE_DEACTIVATED', 'STORE_UPDATED']) || exists(/databases/$(database)/documents/stores/$(request.resource.data.entityId))) &&
              (!(request.resource.data.action in ['SECTOR_ACTIVATED', 'SECTOR_DEACTIVATED', 'SECTOR_UPDATED']) || exists(/databases/$(database)/documents/sectors/$(request.resource.data.entityId))) &&
              (!(request.resource.data.action in ['PRODUCT_ACTIVATED', 'PRODUCT_DEACTIVATED', 'PRODUCT_UPDATED']) || exists(/databases/$(database)/documents/products/$(request.resource.data.entityId)))
            )
          ) ||
          // 2. SETOR_LEADER: Can ONLY record WITHDRAWAL_REQUEST_CREATED for their own store and sector
          (
            getUserData().role == 'SETOR_LEADER' &&
            request.resource.data.userRole == 'SETOR_LEADER' &&
            request.resource.data.action == 'WITHDRAWAL_REQUEST_CREATED' &&
            request.resource.data.entityType == 'WITHDRAWAL_REQUEST' &&
            request.resource.data.storeId == getUserData().storeId &&
            request.resource.data.sectorId == getUserData().sectorId &&
            exists(/databases/$(database)/documents/withdrawalRequests/$(request.resource.data.entityId)) &&
            get(/databases/$(database)/documents/withdrawalRequests/$(request.resource.data.entityId)).data.requestedBy == request.auth.uid &&
            get(/databases/$(database)/documents/withdrawalRequests/$(request.resource.data.entityId)).data.storeId == getUserData().storeId
          ) ||
          // 3. AVARISTA: Can ONLY record conference and evidence actions for requests in their own store
          (
            getUserData().role == 'AVARISTA' &&
            request.resource.data.userRole == 'AVARISTA' &&
            request.resource.data.storeId == getUserData().storeId &&
            (
              (
                request.resource.data.action in ['CONFERENCE_STARTED', 'ITEM_CHECKED', 'WITHDRAWAL_COMPLETED', 'WITHDRAWAL_DIVERGENCE'] &&
                request.resource.data.entityType == 'WITHDRAWAL_REQUEST' &&
                exists(/databases/$(database)/documents/withdrawalRequests/$(request.resource.data.entityId)) &&
                get(/databases/$(database)/documents/withdrawalRequests/$(request.resource.data.entityId)).data.storeId == getUserData().storeId
              ) ||
              (
                request.resource.data.action == 'EVIDENCE_ADDED' &&
                request.resource.data.entityType == 'EVIDENCE' &&
                request.resource.data.metadata.keys().hasAll(['requestId']) &&
                exists(/databases/$(database)/documents/withdrawalRequests/$(request.resource.data.metadata.requestId)) &&
                get(/databases/$(database)/documents/withdrawalRequests/$(request.resource.data.metadata.requestId)).data.storeId == getUserData().storeId
              )
            )
          )
        );

      // Absolute immutability: updates and deletions are strictly forbidden for all users
      allow update, delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
